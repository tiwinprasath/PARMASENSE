# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this to your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# Vercel admin account: set these as server-side Vercel environment variables.
# Use the same email/passcode you want to sign in with. Never expose the password
# with a VITE_ prefix or commit its real value.
VERCEL_ADMIN_EMAIL="admin@example.com"
VERCEL_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_ADMIN_PASSCODE"
VERCEL_ADMIN_NAME="PharmaSense Administrator"

# PORT: Port the Express backend (server/index.js) listens on.
PORT=4000

# VITE_API_PROXY_TARGET: Where the Vite dev server proxies /api requests to.
# Only needed if you run the backend on a non-default port/host.
VITE_API_PROXY_TARGET="http://localhost:4000"
